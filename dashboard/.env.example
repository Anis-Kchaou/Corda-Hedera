# Standalone development only. Do not set FIGMA or FIGMA_EID.
# Generate your own secret:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# SQLite file URL; relative to the directory where you run npm.
DATABASE_URL=file:./medproof.db

# Public application origin, not a secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local filesystem storage. Keep outside public/ to preserve file access checks.
UPLOAD_DIR=./uploads

# Optional: Next.js defaults to 3000.
PORT=3000
MEDPROOF_API_URL=http://127.0.0.1:8000
