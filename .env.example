# Copier en .env (jamais commité) puis adapter.
USE_MOCKS=true                 # true = faux Corda + faux Hedera en mémoire (développement / démo)
STORAGE_DIR=./data/storage
SYNC_DB_PATH=./data/sync.db
POLL_INTERVAL_S=2

# Hedera Testnet (USE_MOCKS=false)
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Pont REST vers Corda (USE_MOCKS=false)
CORDA_BRIDGE_URL=http://localhost:10050
